{
  "name": "portohr",
  "version": "1.0.0",
  "private": true,
  "description": "PortoHR - HR management system (Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test test/*.test.js",
    "build:css": "echo Stylesheet is pre-built in public/css/tailwind.css, nothing to build",
    "css:compile": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.input.css -o public/css/tailwind.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.input.css -o public/css/tailwind.css --watch",
    "create-users": "node src/scripts/create-users.js",
    "stamp": "node scripts/stamp-assets.js",
    "create-admin": "node src/scripts/create-admin.js",
    "seed:demo": "node src/scripts/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
