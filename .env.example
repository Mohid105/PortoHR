# Copy to .env (never commit .env). In production every value below marked REQUIRED must be set.

NODE_ENV=production
PORT=5000

# REQUIRED in production. MongoDB Atlas looks like:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portohr?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/portohr

# REQUIRED in production: a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# Leave empty when the website and API share one domain (the normal case).
# Only list origins if another site must call the API, e.g. https://hr.example.com
CORS_ORIGIN=

# The company's timezone (IANA name). Shifts, clock-ins and month boundaries follow it,
# so it must be right even if the server itself runs in UTC.
APP_TIMEZONE=Asia/Karachi

# Reverse proxies in front of the app (Hostinger, nginx, Cloudflare: 1). Needed for correct client IPs.
TRUST_PROXY=1

# Optional tuning
API_RATE_LIMIT=600
MONGO_POOL_SIZE=10
